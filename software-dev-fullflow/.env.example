# ============================================================================ #
# 研发团队调度 Loop（software-dev-fullflow）统一配置模板
#
# 用法：
#   1. 复制为 .env：   copy .env.example .env
#   2. 按需修改敏感字段（密码 / API Key 等，见各段说明）
#   3. 运行入口（run.py / entry-cli.ps1 / reinstall-agentteams.ps1）会自动读取
#
# 安全约定：
#   - 敏感字段（密码 / Token / API Key）一律留空，注释里说明从哪里获取；
#     不要在本模板或任何脚本里填真实凭据。
#   - .env 已被 .gitignore 忽略（.env / .env.* 除 !.env.example），不会提交。
# ============================================================================ #


# ============================================================================ #
# 一、AgentTeams 平台连接（Python 客户端 AgentTeamsClient 读取）
# ============================================================================ #
# AGT_MODE: docker | local
#   docker —— 通过 `docker exec agentteams-controller agt` 调用官方 CLI（默认）
#   local  —— 直接调用本机 agt 命令（本地安装场景）
AGT_MODE=docker

# AGT_CONTROLLER: docker 模式下执行 agt 的容器名
AGT_CONTROLLER=agentteams-controller

# AGT_CONTROLLER_API: Controller REST API 地址（HTTP fallback 用）
AGT_CONTROLLER_API=http://127.0.0.1:18080

# --- Matrix 协议（提交任务 / 监控里程碑走 Matrix）---
# 从何处获取：运行 `reinstall-agentteams.ps1` 或查看 controller 容器环境
#   docker exec agentteams-controller env | grep AGENTTEAMS_MATRIX
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:18080
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:18080

# --- 账号 / 凭据 ---
# 管理后台账号（Element Web 登录，http://127.0.0.1:18088）
AGENTTEAMS_ADMIN_USER=admin
# 管理后台密码 —— 【敏感】留空，安装时由 reinstall-agentteams.ps1 生成并写入本文件
AGENTTEAMS_ADMIN_PASSWORD=

# Manager 用户（任务提交的接收方）
AGENTTEAMS_MANAGER_USER=manager

# --- Controller REST API 认证 token ---
# 优先读 AGENTTEAMS_AUTH_TOKEN；为空则读 AGENTTEAMS_AUTH_TOKEN_FILE 指向的文件。
# 从何处获取：controller 容器内 /etc/agentteams/ 下的 token 文件。
AGENTTEAMS_AUTH_TOKEN=
AGENTTEAMS_AUTH_TOKEN_FILE=.agentteams_token


# ============================================================================ #
# 二、Loop 运行行为（agentteams_loop.py 读取）
# ============================================================================ #
# 最大委托/续跑轮次（总预算 = 轮次 × TASK_TIMEOUT，防无限循环）
MAX_DELEGATE_ROUNDS=6

# 人工审批 TTL（秒）：>0 时审批超时自动放行兜底；<=0 表示不超时仅人工审批
APPROVAL_TTL_SECS=60

# 发布审批是否等待人工确认：1=等待（配合审批 TTL 兜底），0=不等待直接走自动放行
APPROVAL_WAIT=0


# ============================================================================ #
# 三、部署 / LLM（reinstall-agentteams.ps1 部署平台时读取）
# ============================================================================ #
# 平台默认 LLM（OpenAI 兼容）
AGENTTEAMS_DEFAULT_MODEL=deepseek-v4-flash
AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com/v1

# LLM API Key —— 【敏感】留空。
# 从何处获取：你的 LLM 服务商控制台（如 DeepSeek 开放平台）。
# 安装脚本若检测到 DEEPSEEK_API_KEY 已设置，会用其作为回退。
AGENTTEAMS_LLM_API_KEY=

# DeepSeek（OpenAI 兼容）——旧 demo/.env 的等价项，也用于本地 mock/直连
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash


# ============================================================================ #
# 四、旧 WorkBuddy（CodeBuddy）API —— 仅 WorkBuddy 客户端使用，可留空跳过
#    引用 src/loop/.env.example（WORKBUDDY_*）
# ============================================================================ #
# WORKBUDDY_AUTH_MODE=local_file
# WORKBUDDY_BASE_URL=https://copilot.tencent.com
# WORKBUDDY_CHAT_PATH=/v2/chat/completions
# WORKBUDDY_MODEL=deepseek-v4-flash
# WORKBUDDY_REASONING_MODEL=deepseek-v4-pro
