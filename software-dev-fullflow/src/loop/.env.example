# ========================================================================== #
# WorkBuddy (CodeBuddy) API 配置模板
# 复制本文件为 .env 即可使用：
#   copy .env.example .env
# ========================================================================== #
# 认证方式：local_file（从本地 auth 文件自动读取，推荐）
# 前提：已安装 CodeBuddy/WorkBuddy 桌面版并已登录
WORKBUDDY_AUTH_MODE=local_file

# API 后端地址
WORKBUDDY_BASE_URL=https://copilot.tencent.com
WORKBUDDY_CHAT_PATH=/v2/chat/completions

# 默认模型（deepseek-v4-flash / deepseek-v4-pro / hunyuan-2.0-instruct）
WORKBUDDY_MODEL=deepseek-v4-flash
WORKBUDDY_REASONING_MODEL=deepseek-v4-pro